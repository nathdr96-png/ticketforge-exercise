# react-native-web stands in for react-native in this build: the bundler aliases
# the import (see vite.config.ts) and the types are declared in
# src/types/react-native.d.ts. Nothing here ever loads the real react-native
# package, whose sources are Flow-typed and whose peer range would drag React 19
# and an Android/iOS toolchain into a web bundle.
#
# npm, though, installs peerDependencies eagerly, and
# @react-native-picker/picker declares `react-native: "*"`. Resolving that peer
# for real is what we are deliberately not doing, so peer resolution is off.
# Every direct dependency in package.json is pinned to a range we chose.
legacy-peer-deps=true
