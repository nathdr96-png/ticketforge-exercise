# The database the queries run against. `make seed` drops and recreates the
# public schema in it, so point it at a database you own.
DATABASE_URL=postgres://ticketforge:ticketforge@localhost:5432/ticketforge

# Where `make run` writes one JSON file per question id. The grader reads this
# same directory; see contract/analytics/README.md for the file format.
RESULTS_DIR=./results
