# The TicketForge backend under test. Any backend will do — the suite is black
# box. From a backend's directory:
#   make migrate seed && PORT=3100 make run
BASE_URL=http://127.0.0.1:3100

# Contract parameters. Leave them unset to use the contract defaults; set them to
# match the deployment under test when it runs with a different fee formula or
# hold TTL. The suite reads these rather than hardcoding them, so a differently
# configured deployment does not turn into a wall of red.
#FEE_PERCENT=5
#FEE_FIXED_CENTS=30
#HOLD_TTL_SECONDS=600
