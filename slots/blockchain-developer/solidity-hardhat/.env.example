# TicketForge — blockchain/solidity-hardhat
#
# Every variable here is optional and every default is the contract's. There is
# deliberately NO private key, NO RPC URL and NO mnemonic override: this slot
# deploys to an in-process local development chain whose accounts come from the
# standard local mnemonic declared in contract/onchain/rules.yaml. A slot in
# this family that needs a key from the environment is misconfigured, and
# conformance/blockchain fails it (ONC-002).

# Where `make run` writes its deployment declaration. The conformance suite
# reads the same path from its own CHAIN_DEPLOYMENT, which has no default.
CHAIN_DEPLOYMENT=./deployment/deployment.json

# The two parameters of the product's published fee rule
# (contract/openapi.yaml): fee = floor(subtotal_after_discount * FEE_PERCENT /
# 100) + FEE_FIXED_CENTS. Changing them changes what the sale charges and what
# the suite expects, because the suite computes the fee from the deployment's
# own declared parameters.
FEE_PERCENT=5
FEE_FIXED_CENTS=30
