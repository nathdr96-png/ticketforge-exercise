{
  "extends": "solhint:recommended",
  "rules": {
    "compiler-version": [
      "error",
      "0.8.28"
    ],
    "func-visibility": [
      "error",
      {
        "ignoreConstructors": true
      }
    ],
    "max-line-length": [
      "warn",
      120
    ],
    "no-empty-blocks": "off",
    "gas-custom-errors": "off",
    "immutable-vars-naming": [
      "off"
    ]
  }
}
