# Base URL of the TicketForge API (contract/openapi.yaml), no trailing slash.
# Vite inlines VITE_* at build time — which is also how a device build works, so
# rebuild after changing this.
VITE_API_BASE_URL=http://127.0.0.1:3000

# Port for `make run` / `npm run preview` (read by vite.config.ts).
PORT=5173
