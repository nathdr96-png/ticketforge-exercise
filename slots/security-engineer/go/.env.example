PORT=3000
DATABASE_URL=postgres://ticketforge:ticketforge@localhost:5432/ticketforge
JWT_SECRET=ticketforge-dev-secret-change-me
HOLD_TTL_SECONDS=600
FEE_PERCENT=5
FEE_FIXED_CENTS=30
LOG_LEVEL=info
# Optional: path to the repo's contract/ directory. Auto-detected by walking up
# from the working directory, so you normally do not need to set this.
# CONTRACT_DIR=../../../contract
# Optional tuning.
# DB_MAX_CONNS=20
# BCRYPT_COST=10
# HOLD_EXPIRY_TICK_MS=1000
#
# NOTE: there is no REDIS_URL. Seat exclusivity is enforced with Postgres row
# locks alone; this backend has no Redis dependency.
