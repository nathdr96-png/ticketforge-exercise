{
  "name": "@ticketforge/mobile-react-native",
  "version": "1.0.0",
  "private": true,
  "description": "TicketForge buyer app — React Native, rendered to the web with react-native-web",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@react-native-picker/picker": "^2.11.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native-web": "^0.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
