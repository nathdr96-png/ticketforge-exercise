# The turnstile scanner has no database, no server and no port. These are the
# only two variables it has, and neither has a default anywhere that matters.

# Where `make run` writes the device's decisions and state. conformance/edge
# reads this same directory and refuses to run without it.
SCAN_OUT_DIR=./out

# The repository root, if the Makefile's search for contract/scanner/ cannot
# find it — only needed if the slot has been moved out of slots/<family>/<stack>.
# TF_ROOT=/path/to/ticketforge
