PORT=3000
# libpq-style or JDBC URL — both are accepted.
DATABASE_URL=postgres://ticketforge:ticketforge@localhost:5432/ticketforge
JWT_SECRET=ticketforge-dev-secret-change-me
HOLD_TTL_SECONDS=600
FEE_PERCENT=5
FEE_FIXED_CENTS=30
HOLD_EXPIRY_INTERVAL_MS=1000
LOG_LEVEL=info
# Only needed when the repo's contract/ directory is not an ancestor of the working dir.
# CONTRACT_DIR=/path/to/ticketforge/contract
#
# NOTE: Redis is deliberately NOT a dependency. Seat exclusivity is enforced by
# Postgres row locks alone (SELECT ... FOR UPDATE ordered by seat id).
