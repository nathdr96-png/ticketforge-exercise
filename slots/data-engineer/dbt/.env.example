# The database the models are built in. `make seed` drops and recreates the public
# schema in it, so point it at a database you own. tools/profile.py turns this into
# the profiles.yml dbt wants, so there is only ever one place to set it.
DATABASE_URL=postgres://ticketforge:ticketforge@localhost:5432/ticketforge

# Where `make run` exports one JSON file per question id after `dbt run`.
RESULTS_DIR=./results
